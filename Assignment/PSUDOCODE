    # --------------------------------------------------------
    # PACKET ANIMATION
    # --------------------------------------------------------

    def animate_packet(self):

        topology_name = (
            self.topology_var.get()
        )

        topology = NetworkTopology(
            topology_name
        )

        positions = self.get_positions()

        if not self.current_result:
            return

        path = (
            self.current_result["Path"]
        )

        if not path or len(path) < 2:
            return

        self.animation_points = []

        for node in path:

            if node in positions:

                self.animation_points.append(
                    positions[node]
                )

        if len(self.animation_points) < 2:
            return

        self.animation_index = 0

        self.move_packet()


    def get_positions(self):

        width = max(
            self.canvas.winfo_width(),
            700
        )

        height = max(
            self.canvas.winfo_height(),
            500
        )

        cx = width / 2
        cy = height / 2

        topology = (
            self.topology_var.get()
        )

        positions = {}

        if topology == "Star":

            positions = {
                "CORE": (cx, cy),
                "ICU": (cx - 230, cy - 130),
                "Medical Records": (cx + 230, cy - 130),
                "Laboratory": (cx - 230, cy + 130),
                "Pharmacy / Emergency":
                    (cx + 230, cy + 130)
            }

        elif topology == "Mesh":

            positions = {
                "ICU": (cx - 220, cy - 150),
                "Medical Records":
                    (cx + 220, cy - 150),
                "Laboratory":
                    (cx - 220, cy + 150),
                "Pharmacy / Emergency":
                    (cx + 220, cy + 150)
            }

        elif topology == "Hybrid":

            positions = {
                "CORE": (cx, cy),
                "ICU": (cx - 230, cy - 130),
                "Medical Records":
                    (cx + 230, cy - 130),
                "Laboratory":
                    (cx - 230, cy + 130),
                "Pharmacy / Emergency":
                    (cx + 230, cy + 130)
            }

        elif topology == "Bus":

            positions = {
                "BUS1": (cx - 280, cy),
                "BUS2": (cx - 140, cy),
                "BUS3": (cx, cy),
                "BUS4": (cx + 140, cy),
                "BUS5": (cx + 280, cy),
                "ICU": (cx - 140, cy - 150),
                "Medical Records":
                    (cx, cy - 150),
                "Laboratory":
                    (cx + 140, cy + 150),
                "Pharmacy / Emergency":
                    (cx + 280, cy + 150)
            }

        return positions


    def move_packet(self):

        if hasattr(
            self,
            "packet_item"
        ):

            self.canvas.delete(
                self.packet_item
            )

        points = (
            self.animation_points
        )

        if self.animation_index >= len(points) - 1:

            return

        x1, y1 = points[
            self.animation_index
        ]

        x2, y2 = points[
            self.animation_index + 1
        ]

        steps = 10

        for step in range(
            steps
        ):

            ratio = (
                step
                / steps
            )

            x = (
                x1
                + (x2 - x1)
                * ratio
            )

            y = (
                y1
                + (y2 - y1)
                * ratio
            )

            self.packet_item = (
                self.canvas.create_oval(
                    x - 7,
                    y - 7,
                    x + 7,
                    y + 7,
                    fill="#e67e22",
                    outline="white",
                    width=2,
                    tags="packet"
                )
            )

            self.root.update_idletasks()

            time.sleep(
                0.015
            )

            self.canvas.delete(
                "packet"
            )

        self.animation_index += 1

        self.root.after(
            10,
            self.move_packet
        )


    # --------------------------------------------------------
    # TOPOLOGY COMPARISON
    # --------------------------------------------------------

    def compare_topologies(self):

        protocol = (
            self.protocol_var.get()
        )

        scenario = (
            self.scenario_var.get()
        )

        try:

            packets = int(
                self.packet_var.get()
            )

        except:

            packets = 100

        self.status_var.set(
            "Comparing all topologies..."
        )

        self.log.delete(
            "1.0",
            "end"
        )

        results = []

        for topology in TOPOLOGIES:

            result = self.engine.simulate(
                topology,
                protocol,
                scenario,
                packets
            )

            results.append(
                result
            )

        self.all_results = results

        self.show_comparison(
            results,
            protocol,
            scenario
        )

        self.status_var.set(
            "Topology comparison completed."
        )


