    # --------------------------------------------------------
    # BEST TOPOLOGY
    # --------------------------------------------------------

    def calculate_best(
        self,
        results
    ):

        scored = []

        for result in results:

            score = (
                result["Delivery"] * 0.30
                + result["Throughput"] * 0.20
                + (100 - result["Loss"]) * 0.15
                + max(
                    0,
                    100 - result["Delay"]
                ) * 0.15
                + max(
                    0,
                    100 - result["Jitter"]
                ) * 0.10
                + max(
                    0,
                    100 - result["Utilization"]
                ) * 0.10
            )

            scored.append(
                (
                    score,
                    result
                )
            )

        scored.sort(
            key=lambda x: x[0],
            reverse=True
        )

        return scored[0][1]


