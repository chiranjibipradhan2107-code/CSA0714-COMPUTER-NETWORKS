            "all"
        )

        topology_name = (
            self.topology_var.get()
        )

        topology = NetworkTopology(
            topology_name
        )

        width = max(
            self.canvas.winfo_width(),
            700
        )

        height = max(
            self.canvas.winfo_height(),
            500
        )

        center_x = width / 2

        center_y = height / 2

        positions = {}

        # ----------------------------------------------------
        # Infrastructure positions
        # ----------------------------------------------------

        if topology_name == "Star":

            positions["CORE"] = (
                center_x,
                center_y
            )

            positions["ICU"] = (
                center_x - 230,
                center_y - 130
            )

            positions["Medical Records"] = (
                center_x + 230,
                center_y - 130
            )

            positions["Laboratory"] = (
                center_x - 230,
                center_y + 130
            )

            positions["Pharmacy / Emergency"] = (
                center_x + 230,
                center_y + 130
            )


        elif topology_name == "Mesh":

            positions["ICU"] = (
                center_x - 220,
                center_y - 150
            )

            positions["Medical Records"] = (
                center_x + 220,
                center_y - 150
            )

            positions["Laboratory"] = (
                center_x - 220,
                center_y + 150
            )

            positions["Pharmacy / Emergency"] = (
                center_x + 220,
                center_y + 150
            )


        elif topology_name == "Hybrid":

            positions["CORE"] = (
                center_x,
                center_y
            )

            positions["ICU"] = (
                center_x - 230,
                center_y - 130
            )

            positions["Medical Records"] = (
                center_x + 230,
                center_y - 130
            )

            positions["Laboratory"] = (
                center_x - 230,
                center_y + 130
            )

            positions["Pharmacy / Emergency"] = (
                center_x + 230,
                center_y + 130
            )


        elif topology_name == "Bus":

            bus_y = center_y

            positions["BUS1"] = (
                center_x - 280,
                bus_y
            )

            positions["BUS2"] = (
                center_x - 140,
                bus_y
            )

            positions["BUS3"] = (
                center_x,
                bus_y
            )

            positions["BUS4"] = (
                center_x + 140,
                bus_y
            )

            positions["BUS5"] = (
                center_x + 280,
                bus_y
            )

            positions["ICU"] = (
                center_x - 140,
                center_y - 150
            )

            positions["Medical Records"] = (
                center_x,
                center_y - 150
            )

            positions["Laboratory"] = (
                center_x + 140,
                center_y + 150
            )

            positions["Pharmacy / Emergency"] = (
                center_x + 280,
                center_y + 150
            )


        # ----------------------------------------------------
        # Draw links
        # ----------------------------------------------------

        for a, b in topology.edges:

            if a not in positions or b not in positions:
                continue

            x1, y1 = positions[a]

            x2, y2 = positions[b]

            self.canvas.create_line(
                x1,
                y1,
                x2,
                y2,
                fill="#7f8c8d",
                width=3
            )


        # ----------------------------------------------------
        # Draw infrastructure nodes
        # ----------------------------------------------------

        for node, (x, y) in positions.items():

            if node.startswith("BUS"):

                color = "#95a5a6"

                label = node

            elif node == "CORE":

                color = "#8e44ad"

                label = "CORE"

            else:

                color = ZONE_COLORS.get(
                    node,
                    "#34495e"
                )

                label = node

            radius = 38

            self.canvas.create_oval(
                x - radius,
                y - radius,
                x + radius,
                y + radius,
                fill=color,
                outline="white",
                width=3
            )

            self.canvas.create_text(
                x,
                y,
                text=label,
                fill="white",
                font=(
                    "Arial",
                    9,
                    "bold"
                ),
                width=75
            )


        # ----------------------------------------------------
        # Draw device indicators
        # ----------------------------------------------------

        if topology_name != "Bus":

            for zone in ZONES:

                if zone not in positions:
                    continue

                zx, zy = positions[zone]

                for i in range(10):

                    angle = (
                        i
                        / 10
                        * 2
                        * math.pi
                    )

                    radius = 65

                    dx = (
                        zx
                        + math.cos(angle)
                        * radius
                    )

                    dy = (
                        zy
                        + math.sin(angle)
                        * radius
                    )

                    self.canvas.create_oval(
                        dx - 5,
                        dy - 5,
                        dx + 5,
                        dy + 5,
                        fill=ZONE_COLORS[zone],
                        outline=""
                    )

        else:

            # Devices around bus-connected zones
            for zone in ZONES:

                if zone not in positions:
                    continue

                zx, zy = positions[zone]

                for i in range(10):

                    angle = (
                        i
                        / 10
                        * 2
                        * math.pi
                    )

                    radius = 55

                    dx = (
                        zx
                        + math.cos(angle)
                        * radius
                    )

                    dy = (
                        zy
                        + math.sin(angle)
                        * radius
                    )

                    self.canvas.create_oval(
                        dx - 4,
                        dy - 4,
                        dx + 4,
                        dy + 4,
                        fill=ZONE_COLORS[zone],
                        outline=""
                    )


        # ----------------------------------------------------
        # Title
        # ----------------------------------------------------

        self.canvas.create_text(
            20,
            20,
            text=f"{topology_name.upper()} TOPOLOGY",
            anchor="nw",
            font=(
                "Arial",
                15,
                "bold"
            ),
            fill="#2c3e50"
        )

        self.canvas.create_text(
            20,
            45,
            text="40 End Devices | 4 Hospital Zones",
            anchor="nw",
            font=(
                "Arial",
                10
            ),
            fill="#7f8c8d"
        )


    # --------------------------------------------------------
    # LOG
    # --------------------------------------------------------

    def add_log(self, text):

        self.log.insert(
            "end",
            text + "\n"
        )

        self.log.see(
            "end"
        )


    # --------------------------------------------------------
    # RUN SIMULATION
    # --------------------------------------------------------

    def run_simulation(self):

        try:

            packets = int(
                self.packet_var.get()
            )

            if packets <= 0:
                raise ValueError

            if packets > 10000:
                raise ValueError

        except:

            messagebox.showerror(
                "Invalid Input",
                "Enter a packet count between 1 and 10000."
            )

            return


        topology = (
            self.topology_var.get()
        )

        protocol = (
            self.protocol_var.get()
        )

        scenario = (
            self.scenario_var.get()
        )

        self.status_var.set(
            "Running simulation..."
        )

        self.progress["value"] = 0

        self.log.delete(
            "1.0",
            "end"
        )

        self.add_log(
            "=========================================="
        )

        self.add_log(
            "SMART HEALTHCARE NETWORK SIMULATION"
        )

        self.add_log(
            "=========================================="
        )

        self.add_log(
            f"Topology : {topology}"
        )

        self.add_log(
            f"Protocol : {protocol}"
        )

        self.add_log(
            f"Scenario : {scenario}"
        )

        self.add_log(
            f"Packets  : {packets}"
        )

        self.add_log(
            ""
        )


        # Simulate with visible progress
        self.root.update_idletasks()

        result = self.engine.simulate(
            topology,
            protocol,
            scenario,
            packets
        )

        self.current_result = result

        self.progress["value"] = 100

        self.update_metrics(
            result
        )

        self.animate_packet()

        self.add_log(
            f"Packets Sent     : {result['Sent']}"
        )

        self.add_log(
            f"Packets Received : {result['Received']}"
        )

        self.add_log(
            f"Packet Loss      : {result['Loss']:.2f}%"
        )

        self.add_log(
            f"Delivery Ratio   : {result['Delivery']:.2f}%"
        )

        self.add_log(
            f"Delay            : {result['Delay']:.2f} ms"
        )

        self.add_log(
            f"Jitter           : {result['Jitter']:.2f} ms"
        )

        self.add_log(
            f"Throughput       : {result['Throughput']:.2f} Mbps"
        )

        self.add_log(
            f"Utilization      : {result['Utilization']:.2f}%"
        )

        self.add_log(
            ""
        )

        if result["Path"]:

            self.add_log(
                "Communication Path:"
            )

            self.add_log(
                " -> ".join(
                    result["Path"]
                )
            )

        else:

            self.add_log(
                "No available path due to network disruption."
            )

        self.status_var.set(
            "Simulation completed successfully."
        )


