# ============================================================
# DEVICE MODEL
# ============================================================

class Device:

    def __init__(self, device_id, zone, ip, device_type):

        self.device_id = device_id
        self.zone = zone
        self.ip = ip
        self.device_type = device_type


def create_devices():

    devices = []

    count = 1

    for zone_name, network in ZONES.items():

        for i in range(10):

            device = Device(
                f"D{count:02d}",
                zone_name,
                f"{network}.{i + 10}",
                DEVICE_TYPES[i]
            )

            devices.append(device)

            count += 1

    return devices


# ============================================================
# NETWORK TOPOLOGY
# ============================================================

class NetworkTopology:

    def __init__(self, topology):

        self.topology = topology

        self.nodes = set()

        self.edges = []

        self.adjacency = defaultdict(set)

        self.build()


    def add_edge(self, a, b):

        if a == b:
            return

        if (a, b) not in self.edges and (b, a) not in self.edges:

            self.edges.append((a, b))

            self.nodes.add(a)
            self.nodes.add(b)

            self.adjacency[a].add(b)
            self.adjacency[b].add(a)


    def build(self):

        zones = [
            "ICU",
            "Medical Records",
            "Laboratory",
            "Pharmacy / Emergency"
        ]

        if self.topology == "Star":

            self.nodes.add("CORE")

            for zone in zones:
                self.add_edge("CORE", zone)


        elif self.topology == "Bus":

            bus = [
                "BUS1",
                "BUS2",
                "BUS3",
                "BUS4",
                "BUS5"
            ]

            for i in range(len(bus) - 1):
                self.add_edge(
                    bus[i],
                    bus[i + 1]
                )

            self.add_edge("BUS2", "ICU")
            self.add_edge("BUS3", "Medical Records")
            self.add_edge("BUS4", "Laboratory")
            self.add_edge("BUS5", "Pharmacy / Emergency")


        elif self.topology == "Mesh":

            for zone in zones:
                self.nodes.add(zone)

            for i in range(len(zones)):

                for j in range(i + 1, len(zones)):

                    self.add_edge(
                        zones[i],
                        zones[j]
                    )


        elif self.topology == "Hybrid":

            self.nodes.add("CORE")

            for zone in zones:
                self.add_edge(
                    "CORE",
                    zone
                )

            self.add_edge(
                "ICU",
                "Laboratory"
            )

            self.add_edge(
                "ICU",
                "Pharmacy / Emergency"
            )

            self.add_edge(
                "Laboratory",
                "Pharmacy / Emergency"
            )


    def shortest_path(
        self,
        source,
        destination,
        failed_edges=None
    ):

        if source == destination:
            return [source]

        failed_edges = failed_edges or set()

        queue = deque([source])

        parent = {
            source: None
        }

        while queue:

            current = queue.popleft()

            for neighbor in self.adjacency[current]:

                edge = tuple(
                    sorted(
                        [current, neighbor]
                    )
                )

                if edge in failed_edges:
                    continue

                if neighbor in parent:
                    continue

                parent[neighbor] = current

                if neighbor == destination:

                    path = []

                    node = destination

                    while node is not None:

                        path.append(node)

                        node = parent[node]

                    return path[::-1]

                queue.append(neighbor)

        return None


# ============================================================
# SIMULATION ENGINE
# ============================================================

class SimulationEngine:

    def __init__(self):

        self.devices = create_devices()


    def gateway(self, device):

        return device.zone


    def failed_edges(self, topology, scenario):

        if scenario != "Network Disruption":
            return set()

        if topology == "Star":

            return {
                tuple(
                    sorted(
                        ["CORE", "ICU"]
                    )
                )
            }

        if topology == "Bus":

            return {
                tuple(
                    sorted(
                        ["BUS2", "BUS3"]
                    )
                )
            }

        if topology == "Mesh":

            return {
                tuple(
                    sorted(
                        ["ICU", "Laboratory"]
                    )
                )
            }

        if topology == "Hybrid":

            return {
                tuple(
                    sorted(
                        ["CORE", "ICU"]
                    )
                )
            }

        return set()


    def simulate(
        self,
        topology_name,
        protocol_name,
        scenario_name,
        packets=100
    ):

        topology = NetworkTopology(
            topology_name
        )

        protocol = PROTOCOLS[
            protocol_name
        ]

        scenario = SCENARIOS[
            scenario_name
        ]

        failed = self.failed_edges(
            topology_name,
            scenario_name
        )

        delays = []

        utilization_values = []

        throughput_values = []

        sent = 0

        received = 0

        source = random.choice(
            self.devices
        )

        destination = random.choice(
            self.devices
        )

        while destination.device_id == source.device_id:

            destination = random.choice(
                self.devices
            )

        source_gateway = self.gateway(
            source
        )

        destination_gateway = self.gateway(
            destination
        )

        path = topology.shortest_path(
            source_gateway,
            destination_gateway,
            failed
        )

        for _ in range(packets):

            sent += 1

            if path is None:

                continue

            hops = len(path) + 2

            utilization = min(
                100,
                protocol["packet_size"]
                / 1000
                * scenario["load"]
                * random.uniform(
                    1.0,
                    2.0
                )
            )

            base_delay = {
                "Star": 2.0,
                "Bus": 3.0,
                "Mesh": 1.5,
                "Hybrid": 1.8
            }[topology_name]

            delay = (
                base_delay
                * hops
                * protocol["delay"]
            )

            delay += random.uniform(
                0.5,
                2.5
            )

            delay += (
                scenario["congestion"]
                * utilization
                * 0.12
            )

            # Network resilience
            failure = scenario["failure"]

            if scenario_name == "Network Disruption":

                if topology_name == "Mesh":
                    failure *= 0.25

                elif topology_name == "Hybrid":
                    failure *= 0.45

                elif topology_name == "Star":
                    failure *= 1.10

                elif topology_name == "Bus":
                    failure *= 1.40

            loss_probability = (
                1
                - protocol["reliability"]
            )

            loss_probability += (
                scenario["congestion"]
                * 0.08
            )

            loss_probability += failure

            loss_probability = min(
                0.95,
                loss_probability
            )

            delivered = (
                random.random()
                > loss_probability
            )

            delays.append(
                delay
            )

            utilization_values.append(
                utilization
            )

            if delivered:

                received += 1

                throughput = (
                    protocol["packet_size"]
                    * 8
                    / (delay / 1000)
                    / 1000000
                )

                throughput_values.append(
                    min(
                        100,
                        throughput
                    )
                )

        if sent == 0:
            sent = 1

        delivery_ratio = (
            received
            / sent
            * 100
        )

        loss = (
            100
            - delivery_ratio
        )

        avg_delay = (
            sum(delays)
            / len(delays)
            if delays else 0
        )

        avg_utilization = (
            sum(
                utilization_values
            )
            / len(
                utilization_values
            )
            if utilization_values
            else 0
        )

        avg_throughput = (
            sum(
                throughput_values
            )
            / len(
                throughput_values
            )
            if throughput_values
            else 0
        )

        if len(delays) > 1:

            jitter_values = []

            for i in range(
                1,
                len(delays)
            ):

                jitter_values.append(
                    abs(
                        delays[i]
                        - delays[i - 1]
                    )
                )

            jitter = (
                sum(jitter_values)
                / len(jitter_values)
            )

        else:

            jitter = 0

        response_time = (
            avg_delay * 2
        )

        return {
            "Topology": topology_name,
            "Protocol": protocol_name,
            "Scenario": scenario_name,
            "Sent": sent,
            "Received": received,
            "Delivery": delivery_ratio,
            "Loss": loss,
            "Delay": avg_delay,
            "Response": response_time,
            "Jitter": jitter,
            "Throughput": avg_throughput,
            "Utilization": avg_utilization,
            "Path": path
        }


